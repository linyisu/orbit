+
+    public void orbitLaunch(android.content.Intent intent, int request) {
+        runOnUiThread(() -> {
+            try { startActivityForResult(intent, request); }
+            catch (android.content.ActivityNotFoundException error) { orbitResult(request, 0, null); }
