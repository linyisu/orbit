%YAML 1.2
---
# Markdown inline extensions reuse the bundled Markdown and LaTeX grammars.
# Inject only into Markdown's inline context so code and HTML stay literal.
name: Markdown Inline Extensions
scope: text.html.markdown-inline
hidden: true
contexts:
  main:
    - include: inject
  inject:
    - include: scope:text.html.markdown-inline#math
    - include: scope:text.html.markdown-inline#mark
  mark:
    - match: '(?x)(?<![=\\])(?:\\\\)*(==)(?!=)(?=\S)(?=(?:\\.|[^\\\n])*?(?<=\S)==(?!=))'
      captures:
        1: punctuation.definition.highlight.begin.markdown
      push: marked
  marked:
    - meta_scope: markup.highlight.markdown
    - match: '(?<!\\)(?:\\\\)*(==)(?!=)'
      captures:
        1: punctuation.definition.highlight.end.markdown
      pop: true
    - match: '$'
      pop: true
    - include: scope:text.html.markdown#inline
    - include: scope:text.html.markdown#inline-bold-italic
  math:
    - match: '(?<!\\)(?:\\\\)*(\$\$)'
      captures:
        1: punctuation.definition.math.begin.markdown
      push: block
    - match: '(?x)(?<!\\)(?:\\\\)*(\$)(?!\$)(?=\S)(?=(?:\\.|[^\\$\n])*?(?<=\S)\$(?!\d))'
      captures:
        1: punctuation.definition.math.begin.markdown
      push: inline
  block:
    - meta_scope: markup.math.block.markdown
    - match: '(?<!\\)(?:\\\\)*(\$\$)'
      captures:
        1: punctuation.definition.math.end.markdown
      pop: true
    - include: scope:text.tex.latex#math-content
  inline:
    - meta_scope: markup.math.inline.markdown
    - match: '(?<!\\)(?:\\\\)*(\$)'
      captures:
        1: punctuation.definition.math.end.markdown
      pop: true
    - match: '$'
      pop: true
    - include: scope:text.tex.latex#math-content
