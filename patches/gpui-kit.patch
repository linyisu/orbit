+                        BreakClass::ClosePunctuation
+                            | BreakClass::CloseParenthesis
+                            | BreakClass::Exclamation
+                            | BreakClass::NonStarter
+                            | BreakClass::InfixSeparator
+                    )
+                )
+            {
