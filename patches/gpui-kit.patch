+            }
+        }
+        let allowed = unicode_linebreak::linebreaks(&text)
+            .map(|(index, _)| flow_index(index))
+            .filter(|index| graphemes.binary_search(index).is_ok())
+            .collect();
+        Self {
+            allowed,
+            emergency,
+            graphemes,
+        }
+    }
